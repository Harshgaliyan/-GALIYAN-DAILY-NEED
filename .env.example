PORT=3000
# For a separately hosted frontend, set the exact public website origin(s), comma-separated.
# CORS_ORIGIN=https://your-store.example.com
# On production, set these to paths on the API host's persistent volume.
# DATA_DIR=/var/data/galiyan
# UPLOAD_DIR=/var/data/galiyan/uploads
# Set these before the first server start. The initial password must be at least 12 characters.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Optional: use an address/domain authorized by your SMTP provider.
SMTP_FROM=your-verified-sender@example.com
